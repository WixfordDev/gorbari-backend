# Dependencies
node_modules

# This project uses pnpm; a stray npm lockfile would resolve dependencies
# differently from pnpm-lock.yaml and quietly diverge the two.
package-lock.json

# yarn error logs
yarn-error.log

# Environment varibales
.env*
!.env*.example

# Code coverage
coverage

app.log*

# User-uploaded files are runtime data and stay out of git, but committed
# static assets (e.g. the email logo, the default avatar) must ship with the
# code. The default avatar is referenced by the User model's profileImage
# default, so a clone without it serves 404s for every user who never uploaded
# a picture. Directory rules must be re-included before a file inside them can
# be, hence the /uploads/ and /uploads/users/ lines.
/public/**
!/public/images/
!/public/images/logo.png
!/public/uploads/
!/public/uploads/users/
!/public/uploads/users/user.png
/dist

# Copy this file to .env and fill in real values.
# cp .env.example .env

# HTTP port the REST API listens on.
PORT=8083

# NOTE: socket.io shares the same HTTP server (PORT) — SOCKET_PORT is not
# referenced by the code. Kept here only for reference; you can delete it.
SOCKET_PORT=8056

# URL of the Mongo DB. Use a local one for development or an Atlas cluster.
# MONGODB_URL=mongodb://localhost:27017/gorbariDB
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gorbariDB

NODE_ENV=development   # production | development | test

# JWT secret key — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_with_a_long_random_secret
# Number of minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=30
# Number of days after which an access token expires when "remember me" is checked
JWT_REMEMBER_ACCESS_EXPIRATION_DAYS=7
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=30
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Where site-wide contact-form submissions, new-user/property/subscription
# notifications are delivered to (the platform owner).
CONTACT_US_EMAIL=you@example.com

# Public base URL of the customer website. Used to build listing links in
# notification emails.
WEBSITE_URL=http://localhost:8000

# SMTP configuration options for the email service (e.g. Gmail).
# SMTP_SECURE=true means implicit TLS, which is required on port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465   # 587 for STARTTLS (secure=false)
SMTP_SECURE=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM=Ghorbari <you@gmail.com>

# IP address the server binds to.
BACKEND_IP=0.0.0.0

# ===== CLOUDINARY (image hosting) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== STRIPE (subscription payments — optional) =====
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ===== FIREBASE (push notifications - Admin SDK) =====
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Double-quoted so dotenv expands the \n escapes into real newlines on load.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_KEY_WITH_ESCAPED_NEWLINES\n-----END PRIVATE KEY-----\n"
